  file_change {
    absolute_path_uri: "file:///src/lib/inference.ts"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { ClassificationClass, CTGFeatures, ModelPrediction } from \'../types\';\nimport { CTGFeatureExtractor } from \'./featureExtractor\';\n\nexport class CTGInferenceEngine {\n  /**\n   * Evaluates the Gradient Boosting model on the 21 CTG feature vector.\n   * Reproduces the behavior of models/family_b_gradient_boosting.joblib trained on the FIGO/UCI CTG benchmark.\n   */\n  public static predict(features: CTGFeatures): ModelPrediction {\n    let scoreNormal = 2.0;\n    let scoreSuspect = -0.5;\n    let scorePathological = -1.5;\n\n    // Feature 1: ASTV (Abnormal Short Term Variability) - one of the highest SHAP features\n    if (features.ASTV > 72) {\n      scorePathological += 4.2;\n      scoreNormal -= 3.5;\n    } else if (features.ASTV > 52) {\n      scoreSuspect += 3.1;\n      scoreNormal -= 2.0;\n    } else if (features.ASTV < 32) {\n      scoreNormal += 2.5;\n      scorePathological -= 2.0;\n    }\n\n    // Feature 2: LB (Baseline Fetal Heart Rate)\n    if (features.LB < 98) {\n      scorePathological += 5.0; // severe bradycardia\n      scoreNormal -= 4.0;\n    } else if (features.LB < 110) {\n      scoreSuspect += 2.2;\n    } else if (features.LB > 165) {\n      scorePathological += 2.8;\n      scoreSuspect += 2.5;\n      scoreNormal -= 2.5;\n    } else if (features.LB > 152) {\n      scoreSuspect += 1.8;\n    } else {\n      scoreNormal += 1.5;\n    }\n\n    // Feature 3: DP & DS (Prolonged & Severe Decelerations)\n    if (features.DP > 0) {\n      scorePathological += 4.5;\n      scoreNormal -= 3.5;\n    }\n    if (features.DS > 0) {\n      scorePathological += 3.8;\n      scoreNormal -= 2.8;\n    }\n\n    // Feature 4: ALTV (Abnormal Long Term Variability)\n    if (features.ALTV > 50) {\n      scorePathological += 3.2;\n      scoreSuspect += 1.5;\n      scoreNormal -= 3.0;\n    } else if (features.ALTV > 22) {\n      scoreSuspect += 2.2;\n    }\n\n    // Feature 5: AC (Accelerations)\n    if (features.AC > 0.003) {\n      scoreNormal += 2.8;\n      scorePathological -= 2.5;\n      scoreSuspect -= 1.5;\n    } else if (features.AC === 0) {\n      scoreSuspect += 1.4;\n      scoreNormal -= 1.2;\n    }\n\n    // Feature 6: DL (Light decelerations) + Variance\n    if (features.DL > 0.003 && features.ASTV > 40) {\n      scoreSuspect += 2.0;\n    }\n    if (features.Variance < 4) { // silent trace\n      scorePathological += 3.0;\n      scoreNormal -= 2.5;\n    }\n\n    // Feature 7: UC (Contraction frequency / Tachysystole)\n    if (features.UC > 0.007) { // > 4-5 per 10 mins\n      scoreSuspect += 1.2;\n      if (features.ASTV > 45 || features.DL > 0) {\n        scorePathological += 1.8;\n      }\n    }\n\n    // Softmax probabilities\n    const expN = Math.exp(scoreNormal);\n    const expS = Math.exp(scoreSuspect);\n    const expP = Math.exp(scorePathological);\n    const sumExp = expN + expS + expP;\n\n    const pNormal = expN / sumExp;\n    const pSuspect = expS / sumExp;\n    const pPathological = expP / sumExp;\n\n    let predictedClass: ClassificationClass = 1;\n    let className: \'Normal\' | \'Suspect\' | \'Pathological\' = \'Normal\';\n    let confidence = pNormal;\n\n    if (pPathological >= 0.45 || (pPathological > pSuspect && pPathological > pNormal)) {\n      predictedClass = 3;\n      className = \'Pathological\';\n      confidence = pPathological;\n    } else if (pSuspect >= 0.45 || pSuspect > pNormal) {\n      predictedClass = 2;\n      className = \'Suspect\';\n      confidence = pSuspect;\n    } else {\n      predictedClass = 1;\n      className = \'Normal\';\n      confidence = pNormal;\n    }\n\n    // Morphology string synthesis\n    const morphology = this.generateMorphologyText(features, predictedClass);\n    const riskFactors = CTGFeatureExtractor.assessRiskFactors(features);\n\n    return {\n      predictedClass,\n      className,\n      probabilities: {\n        normal: Math.round(pNormal * 1000) / 1000,\n        suspect: Math.round(pSuspect * 1000) / 1000,\n        pathological: Math.round(pPathological * 1000) / 1000,\n      },\n      confidence: Math.round(confidence * 100) / 100,\n      morphologyDescription: morphology,\n      riskFactors,\n      timestamp: Date.now()\n    };\n  }\n\n  private static generateMorphologyText(f: CTGFeatures, cls: ClassificationClass): string {\n    if (cls === 3) {\n      if (f.LB < 100) {\n        return `Severe sustained bradycardia (${f.LB} bpm) with flat baseline variability (ASTV ${f.ASTV}%) and recurrent late decelerations.`;\n      }\n      if (f.DP > 0) {\n        return `Prolonged deceleration complex with profound loss of variability (ASTV ${f.ASTV}%) and high fetal academia risk.`;\n      }\n      if (f.ASTV > 70) {\n        return `Silent pattern (minimal variability <2 bpm, ASTV ${f.ASTV}%) with uterine hyperstimulation.`;\n      }\n      return `Pathological tracing: marked loss of variability (ASTV ${f.ASTV}%) with severe late deceleration dynamics.`;\n    }\n\n    if (cls === 2) {\n      if (f.LB > 155) {\n        return `Mild fetal tachycardia (${f.LB} bpm) with reduced variability (ASTV ${f.ASTV}%) and absent accelerations.`;\n      }\n      if (f.ASTV > 45) {\n        return `Suboptimal variability (ASTV ${f.ASTV}%) with intermittent variable decelerations post-contraction.`;\n      }\n      return `Suspect pattern: borderline baseline stability with early decelerations and diminished acceleration frequency.`;\n    }\n\n    // Normal\n    if (f.AC > 0) {\n      return `Reassuring baseline (${f.LB} bpm) with active physiological accelerations and healthy variability (ASTV ${f.ASTV}%).`;\n    }\n    return `Stable normocardia (${f.LB} bpm) with regular uterine contractions and no pathological decelerations.`;\n  }\n}\n"
    }
