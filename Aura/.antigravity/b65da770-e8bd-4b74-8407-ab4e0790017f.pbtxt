    replacement_chunks {
      target_content: "  return (\n    <header id=\"main-app-header\" className=\"sticky top-0 z-40 bg-white border-b border-slate-200/90 shadow-xs\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"flex items-center justify-between h-16 gap-4\">\n          \n          {/* Logo & Title */}\n          <div className=\"flex items-center gap-3\">\n            <div className=\"w-10 h-10 rounded-xl bg-gradient-to-tr from-[#0055FF] to-blue-500 flex items-center justify-center text-white shadow-md shadow-blue-500/20\">\n              <Activity className=\"w-5 h-5 animate-pulse\" />\n            </div>\n            <div>\n              <div className=\"flex items-center gap-2\">\n                <span className=\"font-bold text-lg tracking-tight text-[#0B0B14]\">AuraCTG</span>\n                <span className=\"font-serif-accent text-sm text-[#0055FF] font-semibold italic\">Intelligent Telemetry</span>\n                <span className=\"bg-blue-50 text-[#0055FF] border border-blue-200 text-[10px] font-bold px-1.5 py-0.5 rounded tracking-wide uppercase\">\n                  L&D Unit 4\n                </span>\n              </div>\n              <p className=\"text-[11px] text-slate-500 hidden sm:block\">\n                Real-Time Fetal Heart Rate & Uterine Monitoring \342\200\242 Gradient Boosting Inference\n              </p>\n            </div>\n          </div>\n\n          {/* Center / Right Control Hub */}\n          <div className=\"flex items-center gap-2 sm:gap-3\">\n            \n            {/* Live Hospital Time & Shift */}\n            <div className=\"hidden lg:flex items-center gap-2 bg-slate-50 border border-slate-200 px-3 py-1.5 rounded-lg text-xs\">\n              <Clock className=\"w-3.5 h-3.5 text-slate-500\" />\n              <span className=\"font-mono font-medium text-slate-800\">{currentTime}</span>\n              <span className=\"w-1 h-3 bg-slate-300 rounded\"></span>\n              <span className=\"text-slate-600 font-medium\">Day Shift</span>\n            </div>\n\n            {/* On Duty Doctor Pill */}\n            <button\n              id=\"header-on-duty-badge\"\n              onClick={() => setActiveTab(\'roster\')}\n              className=\"flex items-center gap-2 bg-blue-50/80 hover:bg-blue-100/80 border border-blue-200 px-2.5 py-1.5 rounded-lg text-xs transition cursor-pointer text-left\"\n              title=\"Click to view duty roster & escalation chain\"\n            >\n              <div className=\"w-6 h-6 rounded-full bg-[#0055FF] text-white flex items-center justify-center font-bold text-[10px]\">\n                MD\n              </div>\n              <div className=\"hidden md:block\">\n                <div className=\"text-[10px] uppercase font-bold text-[#0055FF] tracking-wider leading-none\">\n                  On-Duty Attending\n                </div>\n                <div className=\"font-medium text-slate-900 leading-tight text-xs\">\n                  {onDutyDoc.name.split(\',\')[0]}\n                </div>\n              </div>\n            </button>\n\n            {/* Audio Telemetry Toggle */}\n            <div className=\"flex items-center bg-slate-100 border border-slate-200 rounded-lg p-1\">\n              <button\n                id=\"header-audio-toggle\"\n                onClick={toggleAudio}\n                className={`flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-medium transition cursor-pointer ${\n                  !isAudioMuted \n                    ? \'bg-emerald-600 text-white shadow-xs\' \n                    : \'text-slate-600 hover:text-slate-900\'\n                }`}\n                title={isAudioMuted ? \'Click to enable real-time FHR Doppler audio & alarm sounds\' : \'Click to mute audio telemetry\'}\n              >\n                {!isAudioMuted ? <Volume2 className=\"w-3.5 h-3.5\" /> : <VolumeX className=\"w-3.5 h-3.5\" />}\n                <span className=\"hidden sm:inline\">{!isAudioMuted ? \'Doppler On\' : \'Muted\'}</span>\n              </button>\n            </div>\n\n            {/* Web Push Permission Button */}\n            {!hasPushPermission && (\n              <button\n                id=\"header-request-push-btn\"\n                onClick={handleRequestPush}\n                className=\"hidden xl:flex items-center gap-1.5 text-xs text-blue-700 bg-blue-50 hover:bg-blue-100 border border-blue-200 px-2.5 py-1.5 rounded-lg transition font-medium cursor-pointer\"\n                title=\"Enable Web Push notifications for clinical alerts\"\n              >\n                <Bell className=\"w-3.5 h-3.5 text-blue-600\" />\n                <span>Enable Push</span>\n              </button>\n            )}\n\n            {/* Active Alert Center Button */}\n            <button\n              id=\"header-alert-center-btn\"\n              onClick={onOpenAlertModal}\n              className={`flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold transition cursor-pointer relative ${\n                unacknowledgedAlertsCount.pathological > 0\n                  ? \'bg-red-600 text-white animate-alert-glow\'\n                  : unacknowledgedAlertsCount.suspect > 0\n                  ? \'bg-amber-500 text-white shadow-xs\'\n                  : \'bg-slate-100 hover:bg-slate-200 text-slate-700 border border-slate-200\'\n              }`}\n            >\n              {unacknowledgedAlertsCount.pathological > 0 ? (\n                <Zap className=\"w-4 h-4 animate-bounce\" />\n              ) : unacknowledgedAlertsCount.suspect > 0 ? (\n                <AlertTriangle className=\"w-4 h-4\" />\n              ) : (\n                <ShieldCheck className=\"w-4 h-4 text-emerald-600\" />\n              )}\n              <span>\n                {totalUnack > 0 ? `${totalUnack} Actionable Alert${totalUnack > 1 ? \'s\' : \'\'}` : \'Alerts Clear\'}\n              </span>\n              {totalUnack > 0 && (\n                <span className=\"w-2 h-2 rounded-full bg-white animate-ping absolute -top-1 -right-1\"></span>\n              )}\n            </button>\n\n          </div>\n        </div>\n\n        {/* Navigation Tabs Bar */}\n        <div className=\"flex items-center justify-between border-t border-slate-100 overflow-x-auto py-1\">\n          <nav className=\"flex space-x-1 sm:space-x-2 py-1 min-w-max\">\n            \n            <button\n              id=\"nav-tab-ward\"\n              onClick={() => setActiveTab(\'ward\')}\n              className={`px-3.5 py-2 rounded-lg text-xs font-medium transition cursor-pointer flex items-center gap-2 ${\n                activeTab === \'ward\'\n                  ? \'bg-[#0055FF] text-white shadow-xs\'\n                  : \'text-slate-600 hover:text-slate-900 hover:bg-slate-100/70\'\n              }`}\n            >\n              <Layers className=\"w-3.5 h-3.5\" />\n              <span>Ward Overview (6 Beds)</span>\n            </button>\n\n            <button\n              id=\"nav-tab-live-monitor\"\n              onClick={() => setActiveTab(\'live-monitor\')}\n              className={`px-3.5 py-2 rounded-lg text-xs font-medium transition cursor-pointer flex items-center gap-2 ${\n                activeTab === \'live-monitor\'\n                  ? \'bg-[#0A0A0F] text-emerald-400 border border-slate-700 shadow-sm\'\n                  : \'text-slate-600 hover:text-slate-900 hover:bg-slate-100/70\'\n              }`}\n            >\n              <Radio className=\"w-3.5 h-3.5 text-emerald-400 animate-pulse\" />\n              <span>Live Waveform Monitor (Bed {selectedBedNumber})</span>\n            </button>\n\n            <button\n              id=\"nav-tab-roster\"\n              onClick={() => setActiveTab(\'roster\')}\n              className={`px-3.5 py-2 rounded-lg text-xs font-medium transition cursor-pointer flex items-center gap-2 ${\n                activeTab === \'roster\'\n                  ? \'bg-[#0055FF] text-white shadow-xs\'\n                  : \'text-slate-600 hover:text-slate-900 hover:bg-slate-100/70\'\n              }`}\n            >\n              <Users className=\"w-3.5 h-3.5\" />\n              <span>Duty Roster & Escalation</span>\n            </button>\n\n            <button\n              id=\"nav-tab-features\"\n              onClick={() => setActiveTab(\'features\')}\n              className={`px-3.5 py-2 rounded-lg text-xs font-medium transition cursor-pointer flex items-center gap-2 ${\n                activeTab === \'features\'\n                  ? \'bg-[#0055FF] text-white shadow-xs\'\n                  : \'text-slate-600 hover:text-slate-900 hover:bg-slate-100/70\'\n              }`}\n            >\n              <BarChart3 className=\"w-3.5 h-3.5\" />\n              <span>21 CTG Features & SHAP</span>\n            </button>\n\n            <button\n              id=\"nav-tab-twilio\"\n              onClick={() => setActiveTab(\'twilio\')}\n              className={`px-3.5 py-2 rounded-lg text-xs font-medium transition cursor-pointer flex items-center gap-2 ${\n                activeTab === \'twilio\'\n                  ? \'bg-[#0055FF] text-white shadow-xs\'\n                  : \'text-slate-600 hover:text-slate-900 hover:bg-slate-100/70\'\n              }`}\n            >\n              <PhoneCall className=\"w-3.5 h-3.5\" />\n              <span>Twilio SMS & Voice Hub</span>\n            </button>\n\n            <button\n              id=\"nav-tab-architecture\"\n              onClick={() => setActiveTab(\'architecture\')}\n              className={`px-3.5 py-2 rounded-lg text-xs font-medium transition cursor-pointer flex items-center gap-2 ${\n                activeTab === \'architecture\'\n                  ? \'bg-[#0055FF] text-white shadow-xs\'\n                  : \'text-slate-600 hover:text-slate-900 hover:bg-slate-100/70\'\n              }`}\n            >\n              <Cpu className=\"w-3.5 h-3.5\" />\n              <span>Architecture & Model Specs</span>\n            </button>\n\n          </nav>\n        </div>\n\n      </div>\n    </header>"
