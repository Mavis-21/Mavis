  file_change {
    absolute_path_uri: "file:///src/components/WardOverview.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { \n  ShieldCheck, \n  AlertTriangle, \n  Zap, \n  Activity, \n  Clock, \n  ArrowUpRight, \n  Heart, \n  Waves, \n  Flame, \n  SlidersHorizontal,\n  ChevronRight,\n  UserCheck,\n  CheckCircle2,\n  Stethoscope\n} from \'lucide-react\';\nimport { Patient, TrajectoryType } from \'../types\';\n\ninterface WardOverviewProps {\n  patients: Patient[];\n  onSelectBed: (bedId: string) => void;\n  onUpdateTrajectory: (patientId: string, trajectory: TrajectoryType) => void;\n  onOpenAlertModalForPatient: (patient: Patient) => void;\n}\n\nexport const WardOverview: React.FC<WardOverviewProps> = ({\n  patients,\n  onSelectBed,\n  onUpdateTrajectory,\n  onOpenAlertModalForPatient\n}) => {\n  const [filter, setFilter] = useState<\'all\' | \'normal\' | \'suspect\' | \'pathological\'>(\'all\');\n\n  const filteredPatients = patients.filter(p => {\n    if (filter === \'all\') return true;\n    if (filter === \'normal\') return p.latestPrediction.predictedClass === 1;\n    if (filter === \'suspect\') return p.latestPrediction.predictedClass === 2;\n    if (filter === \'pathological\') return p.latestPrediction.predictedClass === 3;\n    return true;\n  });\n\n  const countNormal = patients.filter(p => p.latestPrediction.predictedClass === 1).length;\n  const countSuspect = patients.filter(p => p.latestPrediction.predictedClass === 2).length;\n  const countPathological = patients.filter(p => p.latestPrediction.predictedClass === 3).length;\n\n  return (\n    <div id=\"ward-overview-container\" className=\"space-y-6\">\n      \n      {/* Top Ward Header / Stats Banner */}\n      <div className=\"bg-white rounded-2xl p-5 border border-slate-200/90 shadow-xs flex flex-col md:flex-row md:items-center justify-between gap-4\">\n        <div>\n          <div className=\"flex items-center gap-2 mb-1\">\n            <h1 className=\"text-xl sm:text-2xl font-bold text-[#0B0B14] tracking-tight\">\n              Labor & Delivery <span className=\"font-serif-accent text-[#0055FF] italic font-normal text-2xl sm:text-3xl\">Central Ward</span>\n            </h1>\n            <span className=\"bg-emerald-50 text-emerald-700 border border-emerald-200 text-xs px-2 py-0.5 rounded-full font-medium flex items-center gap-1\">\n              <span className=\"w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse\"></span>\n              Live Telemetry 4Hz\n            </span>\n          </div>\n          <p className=\"text-sm text-[#4B4B55] max-w-2xl\">\n            Simultaneous multi-bed cardiotocography monitoring with real-time gradient boosting risk stratification and automated on-call duty escalation.\n          </p>\n        </div>\n\n        {/* Status Filter Buttons */}\n        <div className=\"flex items-center gap-2 bg-[#FAFAFA] p-1.5 rounded-xl border border-slate-200 self-start md:self-auto\">\n          <button\n            onClick={() => setFilter(\'all\')}\n            className={`px-3 py-1.5 rounded-lg text-xs font-semibold transition cursor-pointer ${\n              filter === \'all\' ? \'bg-white text-[#0B0B14] shadow-xs border border-slate-200\' : \'text-slate-600 hover:text-slate-900\'\n            }`}\n          >\n            All Beds ({patients.length})\n          </button>\n          <button\n            onClick={() => setFilter(\'normal\')}\n            className={`px-2.5 py-1.5 rounded-lg text-xs font-medium transition cursor-pointer flex items-center gap-1.5 ${\n              filter === \'normal\' ? \'bg-emerald-50 text-emerald-800 border border-emerald-200 font-semibold\' : \'text-emerald-700 hover:bg-emerald-50/50\'\n            }`}\n          >\n            <ShieldCheck className=\"w-3.5 h-3.5 text-emerald-600\" />\n            <span>Normal ({countNormal})</span>\n          </button>\n          <button\n            onClick={() => setFilter(\'suspect\')}\n            className={`px-2.5 py-1.5 rounded-lg text-xs font-medium transition cursor-pointer flex items-center gap-1.5 ${\n              filter === \'suspect\' ? \'bg-amber-50 text-amber-800 border border-amber-200 font-semibold\' : \'text-amber-700 hover:bg-amber-50/50\'\n            }`}\n          >\n            <AlertTriangle className=\"w-3.5 h-3.5 text-amber-600\" />\n            <span>Suspect ({countSuspect})</span>\n          </button>\n          <button\n            onClick={() => setFilter(\'pathological\')}\n            className={`px-2.5 py-1.5 rounded-lg text-xs font-medium transition cursor-pointer flex items-center gap-1.5 ${\n              filter === \'pathological\' ? \'bg-red-50 text-red-800 border border-red-200 font-semibold\' : \'text-red-700 hover:bg-red-50/50\'\n            }`}\n          >\n            <Zap className=\"w-3.5 h-3.5 text-red-600\" />\n            <span>Pathological ({countPathological})</span>\n          </button>\n        </div>\n      </div>\n\n      {/* Beds Grid */}\n      <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5\">\n        {filteredPatients.map(patient => {\n          const pred = patient.latestPrediction;\n          const isNormal = pred.predictedClass === 1;\n          const isSuspect = pred.predictedClass === 2;\n          const isPathological = pred.predictedClass === 3;\n\n          const badgeBg = isNormal \n            ? \'bg-emerald-50 text-emerald-800 border-emerald-200\'\n            : isSuspect\n            ? \'bg-amber-50 text-amber-800 border-amber-200\'\n            : \'bg-red-50 text-red-800 border-red-200\';\n\n          const cardBorder = isPathological \n            ? \'border-red-300 ring-2 ring-red-500/20\'\n            : isSuspect\n            ? \'border-amber-200\'\n            : \'border-slate-200\';\n\n          return (\n            <div\n              key={patient.id}\n              id={`bed-card-${patient.id}`}\n              className={`bg-white rounded-2xl p-5 border ${cardBorder} shadow-xs hover:shadow-md transition duration-200 flex flex-col justify-between`}\n            >\n              <div>\n                \n                {/* Card Top: Bed Number, Patient Info, Status Badge */}\n                <div className=\"flex items-start justify-between gap-3 pb-3 border-b border-slate-100\">\n                  <div className=\"flex items-center gap-2.5\">\n                    <div className=\"w-10 h-10 rounded-xl bg-slate-900 text-white font-mono font-bold flex items-center justify-center text-sm shadow-xs\">\n                      {patient.bedNumber}\n                    </div>\n                    <div>\n                      <h2 className=\"font-bold text-base text-[#0B0B14] leading-tight\">\n                        {patient.name}\n                      </h2>\n                      <div className=\"flex items-center gap-2 text-xs text-slate-500 mt-0.5\">\n                        <span className=\"font-medium text-slate-700\">{patient.gestationalAge}</span>\n                        <span>\342\200\242</span>\n                        <span>{patient.parity}</span>\n                        <span>\342\200\242</span>\n                        <span>{patient.cervicalDilation.split(\'/\')[0]}</span>\n                      </div>\n                    </div>\n                  </div>\n\n                  {/* Classification Badge */}\n                  <div className={`px-2.5 py-1 rounded-full text-xs font-semibold border flex items-center gap-1.5 shrink-0 ${badgeBg}`}>\n                    {isNormal && <ShieldCheck className=\"w-3.5 h-3.5 text-emerald-600\" />}\n                    {isSuspect && <AlertTriangle className=\"w-3.5 h-3.5 text-amber-600\" />}\n                    {isPathological && <Zap className=\"w-3.5 h-3.5 text-red-600 animate-pulse\" />}\n                    <span>{pred.className}</span>\n                  </div>\n                </div>\n\n                {/* Live Readouts Row */}\n                <div className=\"grid grid-cols-3 gap-2 my-3.5 text-center\">\n                  <div className=\"bg-slate-50 border border-slate-100 rounded-xl p-2\">\n                    <div className=\"text-[10px] uppercase font-bold text-slate-500 tracking-wider flex items-center justify-center gap-1\">\n                      <Heart className=\"w-3 h-3 text-red-500\" />\n                      <span>FHR</span>\n                    </div>\n                    <div className={`font-mono text-xl font-bold tracking-tight mt-0.5 ${\n                      isNormal ? \'text-emerald-600\' : isSuspect ? \'text-amber-600\' : \'text-red-600\'\n                    }`}>\n                      {patient.currentFhr} <span className=\"text-[11px] font-normal text-slate-400\">bpm</span>\n                    </div>\n                  </div>\n\n                  <div className=\"bg-slate-50 border border-slate-100 rounded-xl p-2\">\n                    <div className=\"text-[10px] uppercase font-bold text-slate-500 tracking-wider flex items-center justify-center gap-1\">\n                      <Waves className=\"w-3 h-3 text-purple-500\" />\n                      <span>UC / TOCO</span>\n                    </div>\n                    <div className=\"font-mono text-xl font-bold text-purple-700 tracking-tight mt-0.5\">\n                      {patient.currentUc} <span className=\"text-[11px] font-normal text-slate-400\">mmHg</span>\n                    </div>\n                  </div>\n\n                  <div className=\"bg-slate-50 border border-slate-100 rounded-xl p-2\">\n                    <div className=\"text-[10px] uppercase font-bold text-slate-500 tracking-wider\">\n                      CONFIDENCE\n                    </div>\n                    <div className=\"font-mono text-xl font-bold text-slate-800 tracking-tight mt-0.5\">\n                      {Math.round(pred.confidence * 100)}%\n                    </div>\n                  </div>\n                </div>\n\n                {/* Morphology Summary */}\n                <div className=\"bg-slate-50/80 border border-slate-100 rounded-xl p-2.5 text-xs text-slate-700 mb-3\">\n                  <span className=\"font-semibold text-slate-900\">Diagnosis: </span>\n                  {pred.morphologyDescription}\n                </div>\n\n                {/* High Risk Flags */}\n                <div className=\"flex flex-wrap gap-1 mb-4\">\n                  {patient.highRiskFlags.map((flag, idx) => (\n                    <span\n                      key={idx}\n                      className=\"text-[10px] bg-slate-100 text-slate-600 font-medium px-2 py-0.5 rounded-md border border-slate-200/60\"\n                    >\n                      {flag}\n                    </span>\n                  ))}\n                </div>\n\n              </div>\n\n              {/* Card Footer: Simulation Switcher & Open Hero Monitor Button */}\n              <div className=\"pt-3 border-t border-slate-100 space-y-2.5\">\n                \n                {/* Trajectory Simulation Switcher */}\n                <div className=\"flex items-center justify-between text-[11px]\">\n                  <span className=\"font-semibold text-slate-500 uppercase tracking-wider flex items-center gap-1\">\n                    <SlidersHorizontal className=\"w-3 h-3\" />\n                    Simulate:\n                  </span>\n                  <div className=\"flex items-center gap-1\">\n                    <button\n                      onClick={() => onUpdateTrajectory(patient.id, \'normal\')}\n                      className={`px-2 py-0.5 rounded text-[11px] font-medium transition cursor-pointer ${\n                        patient.trajectory === \'normal\'\n                          ? \'bg-emerald-600 text-white font-semibold\'\n                          : \'bg-slate-100 hover:bg-slate-200 text-slate-700\'\n                      }`}\n                      title=\"Set trajectory to Normal\"\n                    >\n                      Normal\n                    </button>\n                    <button\n                      onClick={() => onUpdateTrajectory(patient.id, \'suspect\')}\n                      className={`px-2 py-0.5 rounded text-[11px] font-medium transition cursor-pointer ${\n                        patient.trajectory === \'suspect\'\n                          ? \'bg-amber-500 text-white font-semibold\'\n                          : \'bg-slate-100 hover:bg-slate-200 text-slate-700\'\n                      }`}\n                      title=\"Set trajectory to Suspect drift\"\n                    >\n                      Suspect\n                    </button>\n                    <button\n                      onClick={() => onUpdateTrajectory(patient.id, \'pathological\')}\n                      className={`px-2 py-0.5 rounded text-[11px] font-medium transition cursor-pointer ${\n                        patient.trajectory === \'pathological\'\n                          ? \'bg-red-600 text-white font-semibold\'\n                          : \'bg-slate-100 hover:bg-slate-200 text-slate-700\'\n                      }`}\n                      title=\"Set trajectory to Pathological event\"\n                    >\n                      Pathological\n                    </button>\n                  </div>\n                </div>\n\n                {/* Hero Button: Open Dark Waveform Monitor */}\n                <button\n                  id={`open-monitor-btn-${patient.id}`}\n                  onClick={() => onSelectBed(patient.id)}\n                  className=\"w-full py-2.5 px-4 rounded-xl bg-[#0055FF] hover:bg-blue-700 text-white font-semibold text-xs transition flex items-center justify-center gap-2 cursor-pointer shadow-xs\"\n                >\n                  <Activity className=\"w-4 h-4\" />\n                  <span>Open Live Oscilloscope Monitor</span>\n                  <ChevronRight className=\"w-4 h-4 ml-auto\" />\n                </button>\n\n              </div>\n            </div>\n          );\n        })}\n      </div>\n\n    </div>\n  );\n};\n"
