        lines {
          text: "                        className=\"px-2.5 py-1 rounded-lg bg-slate-100 hover:bg-blue-50 text-slate-700 hover:text-[#0055FF] border border-slate-200 text-[11px] font-medium transition cursor-pointer flex items-center gap-1 ml-auto\""
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
