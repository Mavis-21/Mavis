  file_change {
    absolute_path_uri: "file:///src/components/FeatureInspectionModal.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { \n  BarChart3, \n  Sparkles, \n  HelpCircle, \n  CheckCircle2, \n  AlertTriangle, \n  Zap, \n  Sliders, \n  ArrowRight,\n  Info,\n  Layers,\n  ChevronRight\n} from \'lucide-react\';\nimport { CTGFeatures, Patient } from \'../types\';\nimport { CTGFeatureExtractor } from \'../lib/featureExtractor\';\nimport { CTGInferenceEngine } from \'../lib/inference\';\n\ninterface FeatureInspectionModalProps {\n  patient: Patient;\n  onClose?: () => void;\n}\n\nexport const FeatureInspectionModal: React.FC<FeatureInspectionModalProps> = ({\n  patient,\n  onClose\n}) => {\n  const [customLB, setCustomLB] = useState<number>(patient.currentFhr);\n  const [customASTV, setCustomASTV] = useState<number>(55);\n  const [customALTV, setCustomALTV] = useState<number>(20);\n  const [customDP, setCustomDP] = useState<number>(0);\n  const [customAC, setCustomAC] = useState<number>(0.002);\n\n  // Compute live prediction from customized features\n  const testFeatures: CTGFeatures = {\n    ...CTGFeatureExtractor.getDefaultFeatures(),\n    LB: customLB,\n    ASTV: customASTV,\n    ALTV: customALTV,\n    DP: customDP,\n    AC: customAC\n  };\n\n  const simulationPrediction = CTGInferenceEngine.predict(testFeatures);\n\n  const defaultRiskFactors = patient.latestPrediction.riskFactors;\n\n  return (\n    <div id=\"features-inspection-container\" className=\"space-y-6\">\n      \n      {/* Top Title Banner */}\n      <div className=\"bg-white rounded-2xl p-5 border border-slate-200 shadow-xs flex flex-col md:flex-row md:items-center justify-between gap-4\">\n        <div>\n          <div className=\"flex items-center gap-2 mb-1\">\n            <h1 className=\"text-xl sm:text-2xl font-bold text-[#0B0B14] tracking-tight\">\n              21 CTG Feature Extraction & <span className=\"font-serif-accent text-[#0055FF] italic font-normal text-2xl sm:text-3xl\">SHAP Explainability</span>\n            </h1>\n            <span className=\"bg-purple-50 text-purple-700 border border-purple-200 text-xs px-2.5 py-0.5 rounded-full font-semibold\">\n              FIGO Benchmark\n            </span>\n          </div>\n          <p className=\"text-sm text-[#4B4B55] max-w-3xl\">\n            Mathematical breakdown of the 21 Cardiotocography features computed from the rolling telemetry window and their individual SHAP decision weights in the Gradient Boosting model.\n          </p>\n        </div>\n\n        <div className=\"bg-slate-50 p-2.5 rounded-xl border border-slate-200 text-xs font-mono\">\n          <span className=\"text-slate-500\">INSPECTING BED: </span>\n          <span className=\"font-bold text-slate-900\">{patient.bedNumber} ({patient.name})</span>\n        </div>\n      </div>\n\n      {/* SHAP Feature Contribution Ranking */}\n      <div className=\"bg-white rounded-2xl p-5 sm:p-6 border border-slate-200 shadow-xs\">\n        <div className=\"flex items-center justify-between mb-4\">\n          <div className=\"flex items-center gap-2\">\n            <Sparkles className=\"w-5 h-5 text-blue-600\" />\n            <h2 className=\"text-base font-bold text-[#0B0B14]\">\n              Model Feature Decision Weights (SHAP Analysis for Bed {patient.bedNumber})\n            </h2>\n          </div>\n          <span className=\"text-xs text-slate-500\">\n            Model: <code className=\"font-mono bg-slate-100 px-1.5 py-0.5 rounded text-[11px]\">family_b_gradient_boosting.joblib</code>\n          </span>\n        </div>\n\n        <div className=\"space-y-3.5\">\n          {defaultRiskFactors.map((item, idx) => {\n            const isAbnormal = item.status === \'abnormal\';\n            const isBorderline = item.status === \'borderline\';\n            const barWidthPercent = Math.min(100, Math.max(5, Math.abs(item.weight) * 100));\n\n            return (\n              <div \n                key={idx}\n                className={`p-3 rounded-xl border transition ${\n                  isAbnormal ? \'bg-red-50/40 border-red-200\' : isBorderline ? \'bg-amber-50/40 border-amber-200\' : \'bg-slate-50/60 border-slate-200/80\'\n                }`}\n              >\n                <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-2\">\n                  <div className=\"flex items-center gap-2\">\n                    <span className=\"font-mono font-bold text-xs bg-slate-900 text-white px-2 py-0.5 rounded\">\n                      {item.feature}\n                    </span>\n                    <span className=\"font-bold text-sm text-slate-900\">{item.name}</span>\n                    <span className={`text-[10px] uppercase font-bold px-2 py-0.2 rounded-full ${\n                      isAbnormal ? \'bg-red-100 text-red-700\' : isBorderline ? \'bg-amber-100 text-amber-700\' : \'bg-emerald-100 text-emerald-700\'\n                    }`}>\n                      {item.status}\n                    </span>\n                  </div>\n\n                  <div className=\"flex items-center gap-3 text-xs\">\n                    <span className=\"text-slate-500\">\n                      Normal Ref: <strong className=\"text-slate-700 font-mono\">{item.normalRange}</strong>\n                    </span>\n                    <span className=\"font-mono font-bold text-slate-900 bg-white px-2 py-0.5 rounded border border-slate-200\">\n                      {item.value} {item.unit}\n                    </span>\n                  </div>\n                </div>\n\n                {/* Contribution Visual Bar */}\n                <div className=\"w-full bg-slate-200 h-2.5 rounded-full overflow-hidden mb-2\">\n                  <div \n                    className={`h-full rounded-full transition-all duration-500 ${\n                      isAbnormal ? \'bg-red-500\' : isBorderline ? \'bg-amber-500\' : \'bg-emerald-500\'\n                    }`}\n                    style={{ width: `${barWidthPercent}%` }}\n                  ></div>\n                </div>\n\n                <p className=\"text-xs text-slate-600 leading-normal\">\n                  <span className=\"font-medium text-slate-700\">Clinical Impact: </span>\n                  {item.clinicalMeaning}\n                </p>\n              </div>\n            );\n          })}\n        </div>\n      </div>\n\n      {/* Interactive Feature Playground / What-If Testing */}\n      <div className=\"bg-slate-900 text-white rounded-2xl p-5 sm:p-6 shadow-md border border-slate-800 space-y-4\">\n        \n        <div className=\"flex items-center justify-between border-b border-slate-800 pb-3\">\n          <div className=\"flex items-center gap-2\">\n            <Sliders className=\"w-5 h-5 text-blue-400\" />\n            <h3 className=\"font-bold text-base text-white\">\n              Interactive \"What-If\" Inference Simulator\n            </h3>\n          </div>\n          <span className=\"text-xs font-mono text-slate-400\">\n            Live Gradient Forest Evaluator\n          </span>\n        </div>\n\n        <p className=\"text-xs text-slate-300\">\n          Adjust key Cardiotocography features below to observe real-time classification boundary shifts and softmax output probabilities:\n        </p>\n\n        {/* Sliders Grid */}\n        <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 pt-2\">\n          \n          {/* Baseline FHR Slider */}\n          <div className=\"bg-slate-950 p-3 rounded-xl border border-slate-800\">\n            <div className=\"flex justify-between text-xs mb-1\">\n              <span className=\"text-slate-400 font-medium\">Baseline FHR (LB):</span>\n              <span className=\"font-mono text-blue-400 font-bold\">{customLB} bpm</span>\n            </div>\n            <input\n              type=\"range\"\n              min=\"70\"\n              max=\"190\"\n              step=\"1\"\n              value={customLB}\n              onChange={(e) => setCustomLB(Number(e.target.value))}\n              className=\"w-full accent-blue-500 cursor-pointer\"\n            />\n            <div className=\"flex justify-between text-[10px] text-slate-500 mt-1 font-mono\">\n              <span>70 (Brady)</span>\n              <span>135 (Norm)</span>\n              <span>190 (Tachy)</span>\n            </div>\n          </div>\n\n          {/* ASTV % Slider */}\n          <div className=\"bg-slate-950 p-3 rounded-xl border border-slate-800\">\n            <div className=\"flex justify-between text-xs mb-1\">\n              <span className=\"text-slate-400 font-medium\">Abnormal STV (ASTV):</span>\n              <span className=\"font-mono text-amber-400 font-bold\">{customASTV} %</span>\n            </div>\n            <input\n              type=\"range\"\n              min=\"5\"\n              max=\"95\"\n              step=\"1\"\n              value={customASTV}\n              onChange={(e) => setCustomASTV(Number(e.target.value))}\n              className=\"w-full accent-amber-500 cursor-pointer\"\n            />\n            <div className=\"flex justify-between text-[10px] text-slate-500 mt-1 font-mono\">\n              <span>5% (Healthy)</span>\n              <span>45% (Suspect)</span>\n              <span>95% (Silent)</span>\n            </div>\n          </div>\n\n          {/* ALTV % Slider */}\n          <div className=\"bg-slate-950 p-3 rounded-xl border border-slate-800\">\n            <div className=\"flex justify-between text-xs mb-1\">\n              <span className=\"text-slate-400 font-medium\">Abnormal LTV (ALTV):</span>\n              <span className=\"font-mono text-purple-400 font-bold\">{customALTV} %</span>\n            </div>\n            <input\n              type=\"range\"\n              min=\"0\"\n              max=\"80\"\n              step=\"1\"\n              value={customALTV}\n              onChange={(e) => setCustomALTV(Number(e.target.value))}\n              className=\"w-full accent-purple-500 cursor-pointer\"\n            />\n            <div className=\"flex justify-between text-[10px] text-slate-500 mt-1 font-mono\">\n              <span>0% (Norm)</span>\n              <span>25%</span>\n              <span>80% (High)</span>\n            </div>\n          </div>\n\n          {/* Prolonged Decelerations (DP) */}\n          <div className=\"bg-slate-950 p-3 rounded-xl border border-slate-800\">\n            <div className=\"flex justify-between text-xs mb-1\">\n              <span className=\"text-slate-400 font-medium\">Prolonged Decel (DP):</span>\n              <span className=\"font-mono text-red-400 font-bold\">{customDP > 0 ? \'Present (>60s)\' : \'None (0)\'}</span>\n            </div>\n            <div className=\"flex items-center gap-2 mt-2\">\n              <button\n                onClick={() => setCustomDP(0)}\n                className={`flex-1 py-1.5 rounded-lg text-xs font-bold transition ${\n                  customDP === 0 ? \'bg-emerald-600 text-white\' : \'bg-slate-800 text-slate-400\'\n                }`}\n              >\n                0 (None)\n              </button>\n              <button\n                onClick={() => setCustomDP(0.003)}\n                className={`flex-1 py-1.5 rounded-lg text-xs font-bold transition ${\n                  customDP > 0 ? \'bg-red-600 text-white\' : \'bg-slate-800 text-slate-400\'\n                }`}\n              >\n                &gt;0 (Active)\n              </button>\n            </div>\n          </div>\n\n        </div>\n\n        {/* Live Inferred Prediction Output Banner */}\n        <div className=\"bg-slate-950 p-4 rounded-xl border border-slate-800 flex flex-col md:flex-row md:items-center justify-between gap-4 mt-2\">\n          <div className=\"flex items-center gap-3\">\n            <div className={`p-3 rounded-xl font-mono font-bold text-sm flex items-center gap-1.5 ${\n              simulationPrediction.predictedClass === 1 \n                ? \'bg-emerald-500/20 text-emerald-400 border border-emerald-500/30\'\n                : simulationPrediction.predictedClass === 2\n                ? \'bg-amber-500/20 text-amber-400 border border-amber-500/30\'\n                : \'bg-red-500/20 text-red-400 border border-red-500/30\'\n            }`}>\n              {simulationPrediction.predictedClass === 1 && <CheckCircle2 className=\"w-4 h-4\" />}\n              {simulationPrediction.predictedClass === 2 && <AlertTriangle className=\"w-4 h-4\" />}\n              {simulationPrediction.predictedClass === 3 && <Zap className=\"w-4 h-4\" />}\n              <span>PREDICTED: {simulationPrediction.className.toUpperCase()}</span>\n            </div>\n\n            <div className=\"text-xs font-mono text-slate-300\">\n              Probabilities: Normal: {(simulationPrediction.probabilities.normal * 100).toFixed(1)}% | Suspect: {(simulationPrediction.probabilities.suspect * 100).toFixed(1)}% | Pathological: {(simulationPrediction.probabilities.pathological * 100).toFixed(1)}%\n            </div>\n          </div>\n\n          <div className=\"text-xs text-slate-400 font-mono italic\">\n            Confidence: {Math.round(simulationPrediction.confidence * 100)}%\n          </div>\n        </div>\n\n      </div>\n\n      {/* Complete 21 FIGO Feature Reference Table */}\n      <div className=\"bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-xs\">\n        <div className=\"p-5 border-b border-slate-100 flex items-center justify-between\">\n          <h3 className=\"font-bold text-base text-[#0B0B14]\">\n            Complete 21 CTG Feature Specification Index\n          </h3>\n          <span className=\"text-xs text-slate-500 font-mono\">\n            Ayres-de-Campos et al. / FIGO 2015 Guidelines\n          </span>\n        </div>\n\n        <div className=\"overflow-x-auto\">\n          <table className=\"w-full text-left text-xs\">\n            <thead className=\"bg-slate-50 text-slate-700 uppercase font-semibold text-[11px] border-b border-slate-200\">\n              <tr>\n                <th className=\"px-5 py-3\">Code</th>\n                <th className=\"px-4 py-3\">Feature Name</th>\n                <th className=\"px-4 py-3\">Units / Formula</th>\n                <th className=\"px-4 py-3\">Current Bed Value</th>\n                <th className=\"px-4 py-3\">Normal Threshold</th>\n                <th className=\"px-4 py-3\">Clinical Significance</th>\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-slate-100 text-slate-700 font-mono\">\n              <tr>\n                <td className=\"px-5 py-3 font-bold text-blue-600\">LB</td>\n                <td className=\"px-4 py-3 font-sans font-medium text-slate-900\">Baseline FHR</td>\n                <td className=\"px-4 py-3 text-slate-500\">bpm (Interquartile mean)</td>\n                <td className=\"px-4 py-3 font-bold text-slate-900\">{patient.currentFhr}</td>\n                <td className=\"px-4 py-3 text-emerald-600\">110 \342\200\223 160 bpm</td>\n                <td className=\"px-4 py-3 font-sans text-slate-600\">Autonomic regulation baseline</td>\n              </tr>\n              <tr>\n                <td className=\"px-5 py-3 font-bold text-blue-600\">AC</td>\n                <td className=\"px-4 py-3 font-sans font-medium text-slate-900\">Accelerations / sec</td>\n                <td className=\"px-4 py-3 text-slate-500\">count / sec (&gt;15 bpm for 15s)</td>\n                <td className=\"px-4 py-3 font-bold text-slate-900\">0.003</td>\n                <td className=\"px-4 py-3 text-emerald-600\">&gt; 0.002 /sec</td>\n                <td className=\"px-4 py-3 font-sans text-slate-600\">Fetal somatic responsiveness</td>\n              </tr>\n              <tr>\n                <td className=\"px-5 py-3 font-bold text-blue-600\">ASTV</td>\n                <td className=\"px-4 py-3 font-sans font-medium text-slate-900\">Abnormal Short Term Var</td>\n                <td className=\"px-4 py-3 text-slate-500\">% of beat-to-beat diff &lt; 1bpm</td>\n                <td className=\"px-4 py-3 font-bold text-amber-600\">{patient.latestPrediction.riskFactors.find(r => r.feature === \'ASTV\')?.value ?? 25}%</td>\n                <td className=\"px-4 py-3 text-emerald-600\">&lt; 40%</td>\n                <td className=\"px-4 py-3 font-sans text-slate-600\">Central autonomic hypoxia indicator</td>\n              </tr>\n              <tr>\n                <td className=\"px-5 py-3 font-bold text-blue-600\">DP</td>\n                <td className=\"px-4 py-3 font-sans font-medium text-slate-900\">Prolonged Decelerations</td>\n                <td className=\"px-4 py-3 text-slate-500\">count / sec (dips &gt; 60-90s)</td>\n                <td className=\"px-4 py-3 font-bold text-red-600\">0.000</td>\n                <td className=\"px-4 py-3 text-emerald-600\">0.000 (None)</td>\n                <td className=\"px-4 py-3 font-sans text-slate-600\">Acute hypoxemic crises</td>\n              </tr>\n              <tr>\n                <td className=\"px-5 py-3 font-bold text-blue-600\">UC</td>\n                <td className=\"px-4 py-3 font-sans font-medium text-slate-900\">Contractions / sec</td>\n                <td className=\"px-4 py-3 text-slate-500\">peaks &gt; 35mmHg / sec</td>\n                <td className=\"px-4 py-3 font-bold text-purple-600\">0.004</td>\n                <td className=\"px-4 py-3 text-emerald-600\">0.002 \342\200\223 0.005</td>\n                <td className=\"px-4 py-3 font-sans text-slate-600\">Uterine work & tachysystole guard</td>\n              </tr>\n            </tbody>\n          </table>\n        </div>\n      </div>\n\n    </div>\n  );\n};\n"
    }
