        }
        lines {
          text: "                          : \'bg-slate-100 text-slate-600 border border-slate-200\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                      }`}>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                        <span className={`w-1.5 h-1.5 rounded-full ${"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                          doc.status === \'Available\' ? \'bg-emerald-500\' : doc.status === \'At Bedside\' ? \'bg-blue-500\' : \'bg-slate-400\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
