    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "@import \"tailwindcss\";\n\n@layer base {\n  :root {\n    --font-sans: \'Plus Jakarta Sans\', -apple-system, BlinkMacSystemFont, \'Segoe UI\', Roboto, sans-serif;\n    --font-serif-accent: \'Instrument Serif\', Georgia, serif;\n    --font-mono: \'JetBrains Mono\', \'IBM Plex Mono\', ui-monospace, monospace;\n    --accent-blue: #0055FF;\n    --color-normal: #34D399;\n    --color-suspect: #F5A623;\n    --color-pathological: #F04438;\n    --color-uc: #A78BFA;\n  }\n\n  body {\n    font-family: var(--font-sans);\n    color: #4B4B55;\n    background-color: #FAFAFA;\n  }\n\n  h1, h2, h3, h4, h5, h6 {\n    color: #0B0B14;\n  }\n}\n\n.font-serif-accent {\n  font-family: var(--font-serif-accent);\n  font-style: italic;\n}\n\n.font-mono-monitor {\n  font-family: var(--font-mono);\n}\n\n/* Custom scrollbars */\n::-webkit-scrollbar {\n  width: 6px;\n  height: 6px;\n}\n::-webkit-scrollbar-track {\n  background: transparent;\n}\n::-webkit-scrollbar-thumb {\n  background: #D1D5DB;\n  border-radius: 9999px;\n}\n::-webkit-scrollbar-thumb:hover {\n  background: #9CA3AF;\n}\n\n/* Dark monitor custom scrollbar */\n.dark-scrollbar::-webkit-scrollbar-thumb {\n  background: #272732;\n}\n.dark-scrollbar::-webkit-scrollbar-thumb:hover {\n  background: #3F3F50;\n}\n\n/* ECG oscilloscope grid background */\n.oscilloscope-grid {\n  background-size: 24px 24px, 120px 120px;\n  background-image: \n    linear-gradient(to right, rgba(255, 255, 255, 0.04) 1px, transparent 1px),\n    linear-gradient(to bottom, rgba(255, 255, 255, 0.04) 1px, transparent 1px),\n    linear-gradient(to right, rgba(255, 255, 255, 0.08) 1px, transparent 1px),\n    linear-gradient(to bottom, rgba(255, 255, 255, 0.08) 1px, transparent 1px);\n}\n\n@keyframes pulse-subtle {\n  0%, 100% { opacity: 1; transform: scale(1); }\n  50% { opacity: 0.75; transform: scale(0.98); }\n}\n\n.animate-pulse-subtle {\n  animation: pulse-subtle 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;\n}\n\n@keyframes alert-glow {\n  0%, 100% { box-shadow: 0 0 0 0 rgba(240, 68, 56, 0.4); }\n  50% { box-shadow: 0 0 0 8px rgba(240, 68, 56, 0); }\n}\n\n.animate-alert-glow {\n  animation: alert-glow 1.5s infinite;\n}"
      replacement_content: "@import \"tailwindcss\";\n\n@layer base {\n  :root {\n    --font-sans: \'Plus Jakarta Sans\', -apple-system, BlinkMacSystemFont, \'Segoe UI\', Roboto, Helvetica, Arial, sans-serif;\n    --font-serif-accent: \'Instrument Serif\', Georgia, \'Times New Roman\', serif;\n    --font-mono: \'JetBrains Mono\', \'IBM Plex Mono\', ui-monospace, SFMono-Regular, monospace;\n    --accent-blue: #0055FF;\n    --color-normal: #34D399;\n    --color-suspect: #F5A623;\n    --color-pathological: #F04438;\n    --color-uc: #A78BFA;\n  }\n\n  body {\n    font-family: var(--font-sans);\n    color: #4B4B55;\n    background-color: #FAFAFA;\n    -webkit-font-smoothing: antialiased;\n    -moz-osx-font-smoothing: grayscale;\n  }\n\n  h1, h2, h3, h4, h5, h6 {\n    color: #0B0B14;\n  }\n}\n\n.font-serif-accent {\n  font-family: var(--font-serif-accent);\n  font-style: italic;\n}\n\n.font-mono-monitor {\n  font-family: var(--font-mono);\n}\n\n/* Geometric Balance Monitor Background Grid */\n.geometric-dot-grid {\n  background-image: radial-gradient(#ffffff 0.5px, transparent 0.5px);\n  background-size: 20px 20px;\n}\n\n/* Custom scrollbars */\n::-webkit-scrollbar {\n  width: 6px;\n  height: 6px;\n}\n::-webkit-scrollbar-track {\n  background: transparent;\n}\n::-webkit-scrollbar-thumb {\n  background: #E5E7EB;\n  border-radius: 9999px;\n}\n::-webkit-scrollbar-thumb:hover {\n  background: #9CA3AF;\n}\n\n/* Dark monitor custom scrollbar */\n.dark-scrollbar::-webkit-scrollbar-thumb {\n  background: #1A1A24;\n}\n.dark-scrollbar::-webkit-scrollbar-thumb:hover {\n  background: #272732;\n}\n\n/* ECG oscilloscope grid background */\n.oscilloscope-grid {\n  background-size: 24px 24px, 120px 120px;\n  background-image: \n    linear-gradient(to right, rgba(255, 255, 255, 0.03) 1px, transparent 1px),\n    linear-gradient(to bottom, rgba(255, 255, 255, 0.03) 1px, transparent 1px),\n    linear-gradient(to right, rgba(255, 255, 255, 0.07) 1px, transparent 1px),\n    linear-gradient(to bottom, rgba(255, 255, 255, 0.07) 1px, transparent 1px);\n}\n\n@keyframes pulse-subtle {\n  0%, 100% { opacity: 1; transform: scale(1); }\n  50% { opacity: 0.75; transform: scale(0.98); }\n}\n\n.animate-pulse-subtle {\n  animation: pulse-subtle 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;\n}\n\n@keyframes alert-glow {\n  0%, 100% { box-shadow: 0 0 0 0 rgba(240, 68, 56, 0.4); }\n  50% { box-shadow: 0 0 0 8px rgba(240, 68, 56, 0); }\n}\n\n.animate-alert-glow {\n  animation: alert-glow 1.5s infinite;\n}\n"
