e=\"p-3 bg-white rounded-xl border border-slate-200 text-xs font-mono text-slate-800\">\n              <span className=\"font-bold text-red-600 font-sans\">CTG Pattern: </span>\n              {activeAlert.morphology}\n            </div>\n\n            {isPathological && (\n              <div className=\"flex items-center justify-between text-xs bg-red-50 p-2.5 rounded-xl border border-red-200 text-red-900\">\n                <span className=\"flex items-center gap-1.5 font-semibold\">\n                  <Clock className=\"w-4 h-4 text-red-600 animate-spin\" />\n                  Auto-Escalation to Backup Registrar in:\n                </span>\n                <span className=\"font-mono font-bold text-base text-red-700\">\n                  00:{activeAlert.escalationTimer < 10 ? `0${activeAlert.escalationTimer}` : activeAlert.escalationTimer}s\n                </span>\n              </div>\n            )}\n          </div>\n\n          {/* Quick Interventions Checklist */}\n          <div className=\"space-y-2\">\n            <label className=\"text-xs font-bold uppercase tracking-wider text-slate-600 block\">\n              Immediate Clinical Interventions Performed:\n            </label>\n            \n            <div className=\"grid grid-cols-2 gap-2 text-xs\">\n              {[\n                \'Left Lateral Maternal Tilt\',\n                \'Discontinued Oxytocin Infusion\',\n                \'IV Hartmanns Fluid Bolus 500ml\',\n                \'Maternal O2 (10L Non-Rebreather)\',\n                \'Fetal Scalp Electrode Applied\',\n                \'Attending OB at Bedside\'\n              ].map((item, idx) => {\n                const isSelected = quickInterventions.includes(item);\n                return (\n                  <button\n                    key={idx}\n                    type=\"button\"\n                    onClick={() => toggleIntervention(item)}\n                    className={`p-2.5 rounded-xl border text-left font-medium transition cursor-pointer flex items-center justify-between ${\n                      isSelected \n                        ? \'bg-blue-50 border-blue-300 text-[#0055FF] font-semibold\' \n                        : \'bg-white border-slate-200 text-slate-700 hover:bg-slate-50\'\n                    }`}\n                  >\n                    <span>{item}</span>\n                    {isSelected && <CheckCircle2 className=\"w-4 h-4 text-[#0055FF] shrink-0\" />}\n                  </button>\n                );\n              })}\n            </div>\n          </div>\n\n          {/* Clinician Signature & Free Text */}\n          <div className=\"space-y-3\">\n            <div>\n              <label className=\"text-xs font-bold uppercase tracking-wider text-slate-600 block mb-1\">\n                Acknowledging Clinician / Signature:\n              </label>\n              <select\n                value={selectedClinician}\n                onChange={(e) => setSelectedClinician(e.target.value)}\n                className=\"w-full bg-slate-50 border border-slate-200 rounded-xl p-2.5 text-xs font-medium text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-500\"\n              >\n                {dutyRosterService.getRoster().map(doc => (\n                  <option key={doc.id} value={doc.name}>\n                    {doc.name} ({doc.role})\n                  </option>\n                ))}\n              </select>\n            </div>\n\n            <div>\n              <label className=\"text-xs font-bold uppercase tracking-wider text-slate-600 block mb-1\">\n                Clinical Response & Next Plan Notes:\n              </label>\n              <textarea\n                value={clinicalAction}\n                onChange={(e) => setClinicalAction(e.target.value)}\n                rows={2}\n                placeholder=\"Enter clinical assessment, fetal scalp pH result, or decision for emergency delivery...\"\n                className=\"w-full bg-slate-50 border border-slate-200 rounded-xl p-2.5 text-xs text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500 font-sans\"\n              ></textarea>\n            </div>\n          </div>\n\n        </div>\n\n        {/* Modal Footer */}\n        <div className=\"p-5 bg-slate-50 border-t border-slate-100 flex items-center justify-between gap-3\">\n          <button\n            type=\"button\"\n            onClick={onClose}\n            className=\"px-4 py-2.5 rounded-xl bg-white border border-slate-200 text-slate-700 text-xs font-semibold hover:bg-slate-100 transition cursor-pointer\"\n          >\n            Review Waveforms First\n          </button>\n\n          <button\n            type=\"button\"\n            onClick={handleAcknowledge}\n            className=\"px-6 py-2.5 rounded-xl bg-[#0055FF] hover:bg-blue-600 text-white text-xs font-bold transition flex items-center gap-2 cursor-pointer shadow-md shadow-blue-500/20\"\n          >\n            <CheckCircle2 className=\"w-4 h-4\" />\n            <span>Sign & Acknowledge Alert</span>\n          </button>\n        </div>"
        replacement_content: "      <div className=\"bg-white rounded-2xl max-w-2xl w-full border border-gray-200 shadow-2xl overflow-hidden flex flex-col max-h-[90vh]\">\n        \n        {/* Modal Header */}\n        <div className={`p-5 text-white flex items-center justify-between ${\n          isPathological ? \'bg-[#F04438]\' : \'bg-[#F5A623]\'\n        }`}>\n          <div className=\"flex items-center gap-3\">\n            <div className=\"w-10 h-10 rounded-lg bg-white/20 flex items-center justify-center\">\n              {isPathological ? <Zap className=\"w-6 h-6 animate-pulse\" /> : <AlertTriangle className=\"w-6 h-6\" />}\n            </div>\n            <div>\n              <div className=\"text-[10px] uppercase font-bold tracking-widest text-white/90\">\n                {isPathological ? \'Tier 2/3 Emergency Escalation\' : \'Tier 1 In-App Notification\'}\n              </div>\n              <h2 className=\"text-base sm:text-lg font-bold tracking-tight\">\n                {activeAlert.title}\n              </h2>\n            </div>\n          </div>\n\n          <button\n            onClick={onClose}\n            className=\"p-1.5 rounded-lg bg-white/15 hover:bg-white/25 text-white transition cursor-pointer\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        {/* Modal Body */}\n        <div className=\"p-6 space-y-5 overflow-y-auto\">\n          \n          {/* Patient Card & Diagnosis */}\n          <div className=\"bg-gray-50 rounded-xl p-4 border border-gray-200 space-y-2\">\n            <div className=\"flex items-center justify-between text-xs\">\n              <span className=\"font-bold text-[#0B0B14] text-sm uppercase tracking-wide\">\n                Patient: {activeAlert.patientName} (Bed {activeAlert.bedNumber})\n              </span>\n              <span className=\"font-mono text-gray-400\">\n                Triggered: {new Date(activeAlert.timestamp).toLocaleTimeString()}\n              </