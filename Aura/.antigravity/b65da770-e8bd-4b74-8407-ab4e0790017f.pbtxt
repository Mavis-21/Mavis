        }
        lines {
          text: "  public setPatientTrajectory(patientId: string, trajectory: TrajectoryType) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const existing = this.states.get(patientId);"
