  file_change {
    absolute_path_uri: "file:///src/components/TwilioSimulationDrawer.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useEffect } from \'react\';\nimport { \n  PhoneCall, \n  MessageSquare, \n  Smartphone, \n  Volume2, \n  Send, \n  CheckCircle2, \n  Clock, \n  ShieldAlert, \n  Radio, \n  Play, \n  Square,\n  AlertTriangle,\n  Zap,\n  PhoneForwarded,\n  UserCheck\n} from \'lucide-react\';\nimport { TwilioDispatchRecord } from \'../types\';\nimport { notificationService } from \'../lib/notifications\';\nimport { dutyRosterService } from \'../lib/dutyRoster\';\n\nexport const TwilioSimulationDrawer: React.FC = () => {\n  const [dispatches, setDispatches] = useState<TwilioDispatchRecord[]>(notificationService.getTwilioDispatches());\n  const [isPlayingAudio, setIsPlayingAudio] = useState<string | null>(null);\n  const [customMsg, setCustomMsg] = useState(\'\');\n  const [targetPhone, setTargetPhone] = useState(dutyRosterService.getOnDutyTeam().primary.phone);\n\n  useEffect(() => {\n    const unsub = notificationService.subscribe(() => {\n      setDispatches(notificationService.getTwilioDispatches());\n    });\n    return unsub;\n  }, []);\n\n  const handlePlayVoice = (record: TwilioDispatchRecord) => {\n    if (record.audioTranscript) {\n      setIsPlayingAudio(record.id);\n      notificationService.speakVoiceAlert(record.audioTranscript);\n      setTimeout(() => setIsPlayingAudio(null), 8000);\n    }\n  };\n\n  const handleSendCustomSMS = () => {\n    if (!customMsg.trim()) return;\n    const { primary } = dutyRosterService.getOnDutyTeam();\n    const newRecord: TwilioDispatchRecord = {\n      id: `manual-tw-${Date.now()}`,\n      alertId: \'manual\',\n      patientName: \'Simulated Broadcast\',\n      bedNumber: \'03\',\n      severity: \'pathological\',\n      type: \'SMS\',\n      toNumber: targetPhone,\n      recipientName: primary.name,\n      recipientRole: primary.role,\n      content: customMsg,\n      timestamp: Date.now(),\n      status: \'delivered\',\n      simulated: true\n    };\n    notificationService.getTwilioDispatches().unshift(newRecord);\n    setDispatches([...notificationService.getTwilioDispatches()]);\n    setCustomMsg(\'\');\n  };\n\n  return (\n    <div id=\"twilio-hub-container\" className=\"space-y-6\">\n      \n      {/* Top Banner */}\n      <div className=\"bg-white rounded-2xl p-5 border border-slate-200 shadow-xs flex flex-col lg:flex-row lg:items-center justify-between gap-4\">\n        <div>\n          <div className=\"flex items-center gap-2 mb-1\">\n            <h1 className=\"text-xl sm:text-2xl font-bold text-[#0B0B14] tracking-tight\">\n              Twilio SMS & Automated Voice <span className=\"font-serif-accent text-[#0055FF] italic font-normal text-2xl sm:text-3xl\">Dispatch Terminal</span>\n            </h1>\n            <span className=\"bg-red-50 text-red-700 border border-red-200 text-xs px-2.5 py-0.5 rounded-full font-semibold flex items-center gap-1\">\n              <span className=\"w-2 h-2 rounded-full bg-red-500 animate-pulse\"></span>\n              Live On-Call Pipeline\n            </span>\n          </div>\n          <p className=\"text-sm text-[#4B4B55] max-w-3xl\">\n            Simulates automated cellular emergency dispatching. In a live hospital deployment, this routes through Twilio Programmable SMS and Twilio Voice APIs to the active on-duty obstetrician resolved from the duty roster.\n          </p>\n        </div>\n\n        <div className=\"bg-slate-50 p-2.5 rounded-xl border border-slate-200 text-xs font-mono text-slate-700\">\n          <div>TWILIO REST PROXY: <span className=\"text-emerald-600 font-bold\">ONLINE (SIMULATED)</span></div>\n          <div className=\"text-[11px] text-slate-500\">VOICE SYNTH: Web Speech API TTS</div>\n        </div>\n      </div>\n\n      {/* Main Grid: Phone Simulator & Dispatch Log */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6\">\n        \n        {/* Left: Interactive Simulated Smartphone Screen (5 cols) */}\n        <div className=\"lg:col-span-5 flex flex-col items-center\">\n          <div className=\"w-full max-w-xs bg-slate-950 p-4 rounded-[40px] border-4 border-slate-800 shadow-2xl space-y-3\">\n            \n            {/* Phone Notch & Status */}\n            <div className=\"flex items-center justify-between px-2 pt-1 text-[11px] text-slate-400 font-mono\">\n              <span>9:41</span>\n              <div className=\"w-20 h-4 bg-slate-800 rounded-full\"></div>\n              <span className=\"text-emerald-400\">5G \342\200\242 100%</span>\n            </div>\n\n            {/* Simulated Phone Header */}\n            <div className=\"bg-slate-900/90 rounded-2xl p-3 text-center border border-slate-800\">\n              <div className=\"w-10 h-10 rounded-full bg-[#0055FF] text-white font-bold text-sm flex items-center justify-center mx-auto mb-1\">\n                L&D\n              </div>\n              <div className=\"font-bold text-xs text-white\">AuraCTG Emergency Alert Dispatch</div>\n              <div className=\"text-[10px] text-slate-400 font-mono\">{dutyRosterService.getOnDutyTeam().primary.phone}</div>\n            </div>\n\n            {/* Message Feed inside Phone */}\n            <div className=\"bg-slate-900/60 rounded-2xl p-3 h-80 overflow-y-auto space-y-2.5 text-xs font-mono dark-scrollbar border border-slate-800/80\">\n              {dispatches.length === 0 ? (\n                <div className=\"h-full flex flex-col items-center justify-center text-slate-500 text-center p-4\">\n                  <Smartphone className=\"w-8 h-8 mb-2 opacity-40\" />\n                  <p className=\"text-[11px]\">No active dispatch messages yet. Trigger a Pathological CTG or send a manual test ping.</p>\n                </div>\n              ) : (\n                dispatches.map(rec => (\n                  <div \n                    key={rec.id}\n                    className={`p-2.5 rounded-xl border ${\n                      rec.severity === \'pathological\' \n                        ? \'bg-red-950/40 border-red-800 text-red-200\' \n                        : \'bg-slate-800/80 border-slate-700 text-slate-200\'\n                    }`}\n                  >\n                    <div className=\"flex items-center justify-between text-[10px] text-slate-400 mb-1\">\n                      <span className=\"font-bold uppercase tracking-wider text-blue-400\">\n                        {rec.type === \'SMS\' ? \'\360\237\222\254 SMS DISPATCH\' : \'\360\237\223\236 VOICE CALL\'}\n                      </span>\n                      <span>{new Date(rec.timestamp).toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' })}</span>\n                    </div>\n\n                    <p className=\"text-[11px] leading-relaxed\">\n                      {rec.content}\n                    </p>\n\n                    {rec.type === \'VOICE\' && rec.audioTranscript && (\n                      <button\n                        onClick={() => handlePlayVoice(rec)}\n                        className=\"mt-2 w-full py-1 px-2 rounded bg-blue-600 hover:bg-blue-700 text-white text-[10px] font-bold flex items-center justify-center gap-1 cursor-pointer transition\"\n                      >\n                        <Volume2 className=\"w-3 h-3\" />\n                        <span>{isPlayingAudio === rec.id ? \'Speaking...\' : \'Play Voice Call Audio\'}</span>\n                      </button>\n                    )}\n                  </div>\n                ))\n              )}\n            </div>\n\n            {/* Quick Test Dispatch inside Phone */}\n            <div className=\"pt-1\">\n              <div className=\"flex items-center gap-1.5 bg-slate-900 border border-slate-800 rounded-xl p-1.5\">\n                <input\n                  type=\"text\"\n                  value={customMsg}\n                  onChange={(e) => setCustomMsg(e.target.value)}\n                  placeholder=\"Type simulated SMS text...\"\n                  className=\"bg-transparent text-[11px] text-white placeholder-slate-500 focus:outline-none w-full px-2 font-mono\"\n                />\n                <button\n                  onClick={handleSendCustomSMS}\n                  className=\"p-1.5 rounded-lg bg-[#0055FF] hover:bg-blue-600 text-white cursor-pointer transition\"\n                >\n                  <Send className=\"w-3.5 h-3.5\" />\n                </button>\n              </div>\n            </div>\n\n          </div>\n        </div>\n\n        {/* Right: Dispatch Audit Trail Table (7 cols) */}\n        <div className=\"lg:col-span-7 bg-white rounded-2xl p-5 border border-slate-200 shadow-xs flex flex-col justify-between space-y-4\">\n          \n          <div>\n            <div className=\"flex items-center justify-between mb-3\">\n              <div className=\"flex items-center gap-2\">\n                <Radio className=\"w-5 h-5 text-blue-600 animate-pulse\" />\n                <h2 className=\"font-bold text-base text-[#0B0B14]\">\n                  Outbound Twilio Dispatch Audit Log\n                </h2>\n              </div>\n              <span className=\"text-xs text-slate-500 font-mono\">\n                {dispatches.length} Logs Recorded\n              </span>\n            </div>\n\n            <div className=\"overflow-x-auto\">\n              <table className=\"w-full text-left text-xs\">\n                <thead className=\"bg-slate-50 text-slate-700 uppercase font-semibold text-[11px] border-b border-slate-200\">\n                  <tr>\n                    <th className=\"px-3 py-2.5\">Time</th>\n                    <th className=\"px-3 py-2.5\">Channel</th>\n                    <th className=\"px-3 py-2.5\">Recipient (On-Duty)</th>\n                    <th className=\"px-3 py-2.5\">Bed / Patient</th>\n                    <th className=\"px-3 py-2.5\">Delivery Status</th>\n                    <th className=\"px-3 py-2.5 text-right\">Voice Audio</th>\n                  </tr>\n                </thead>\n                <tbody className=\"divide-y divide-slate-100 text-slate-700 font-mono text-[11px]\">\n                  {dispatches.length === 0 ? (\n                    <tr>\n                      <td colSpan={6} className=\"py-8 text-center text-slate-400 font-sans\">\n                        No automated alerts sent yet. When a patient enters Pathological state, Twilio triggers immediately.\n                      </td>\n                    </tr>\n                  ) : (\n                    dispatches.map(item => (\n                      <tr key={item.id} className=\"hover:bg-slate-50\">\n                        <td className=\"px-3 py-3 text-slate-500\">\n                          {new Date(item.timestamp).toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\', second: \'2-digit\' })}\n                        </td>\n                        <td className=\"px-3 py-3 font-bold\">\n                          <span className={`px-1.5 py-0.5 rounded text-[10px] uppercase ${\n                            item.type === \'SMS\' ? \'bg-blue-100 text-blue-800\' : \'bg-purple-100 text-purple-800\'\n                          }`}>\n                            {item.type}\n                          </span>\n                        </td>\n                        <td className=\"px-3 py-3 font-sans\">\n                          <div className=\"font-bold text-slate-900\">{item.recipientName}</div>\n                          <div className=\"text-[10px] text-slate-500 font-mono\">{item.toNumber}</div>\n                        </td>\n                        <td className=\"px-3 py-3 font-sans\">\n                          <span className=\"font-bold text-slate-800\">Bed {item.bedNumber}</span>\n                          <div className=\"text-[10px] text-slate-500\">{item.patientName}</div>\n                        </td>\n                        <td className=\"px-3 py-3\">\n                          <span className=\"inline-flex items-center gap-1 text-emerald-700 bg-emerald-50 border border-emerald-200 px-2 py-0.5 rounded-full text-[10px] font-bold uppercase\">\n                            <CheckCircle2 className=\"w-3 h-3\" />\n                            {item.status}\n                          </span>\n                        </td>\n                        <td className=\"px-3 py-3 text-right\">\n                          {item.type === \'VOICE\' ? (\n                            <button\n                              onClick={() => handlePlayVoice(item)}\n                              className=\"p-1.5 rounded-lg bg-blue-50 hover:bg-blue-100 text-[#0055FF] border border-blue-200 transition cursor-pointer inline-flex items-center gap-1 text-[10px] font-bold\"\n                              title=\"Listen to automated voice synthesized phone call\"\n                            >\n                              <Volume2 className=\"w-3.5 h-3.5\" />\n                              <span>Listen</span>\n                            </button>\n                          ) : (\n                            <span className=\"text-slate-400 text-[10px]\">\342\200\224</span>\n                          )}\n                        </td>\n                      </tr>\n                    ))\n                  )}\n                </tbody>\n              </table>\n            </div>\n          </div>\n\n          {/* Twilio Architecture Notes */}\n          <div className=\"bg-slate-50 p-3 rounded-xl border border-slate-200 text-xs text-slate-600 flex items-start gap-2.5\">\n            <ShieldAlert className=\"w-4 h-4 text-blue-600 shrink-0 mt-0.5\" />\n            <div>\n              <span className=\"font-bold text-slate-900\">Hospital Escalation Policy: </span>\n              If the primary attending does not acknowledge a Pathological alert within 45 seconds, the decision engine automatically re-routes the next voice call to the backup registrar, followed by the floor charge nurse.\n            </div>\n          </div>\n\n        </div>\n\n      </div>\n\n    </div>\n  );\n};\n"
    }
