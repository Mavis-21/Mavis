          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      activeAcceleration: 0,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      decelerationType: trajectory === \'pathological\' ? \'late\' : trajectory === \'suspect\' ? \'variable\' : \'none\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      timeSeconds: 0,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      sampleBuffer: [],"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      customIntervention: \'none\'"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    };"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    // Pre-populate 30 seconds of buffer"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const initialSamplesCount = 30 * this.sampleRateHz;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    for (let i = 0; i < initialSamplesCount; i++) {"
